# Copy to .env and adjust. Never commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=financial_intelligence
POSTGRES_USER=fi_app
POSTGRES_PASSWORD=change_me_locally

# Database used by the integration test suite (created by scripts/dev_db.sh)
POSTGRES_TEST_DB=financial_intelligence_test

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of origins allowed by CORS
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---------------------------------------------------------------
# Base URL the browser uses to reach the API. Empty = same origin via Vite proxy.
VITE_API_BASE_URL=
